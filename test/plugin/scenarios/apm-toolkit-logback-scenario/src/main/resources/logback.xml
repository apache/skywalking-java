<configuration>
    <appender name="GRPC_TID" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <Pattern>tid-layout %tid %sw_ctx %msg</Pattern>
            </layout>
        </encoder>
    </appender>

    <appender name="GRPC_MDC" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <Pattern>mdc-layout user=%X{user} %X{tid} %X{sw_ctx} %msg</Pattern>
            </layout>
        </encoder>
    </appender>

    <!-- Rendered on the AsyncAppender worker thread, from the context captured when the event was created. -->
    <appender name="GRPC_ASYNC_MDC" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <Pattern>async-mdc-layout user=%X{user} %X{tid} %X{sw_ctx} %msg</Pattern>
            </layout>
        </encoder>
    </appender>
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="GRPC_ASYNC_MDC"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="GRPC_TID"/>
        <appender-ref ref="GRPC_MDC"/>
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
